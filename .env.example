# --- Supervisor brain: set ONE of these ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model used for the Supervisor's routing decisions.
# Anthropic example: claude-opus-5-5
# OpenAI example: gpt-4.1
SUPERVISOR_MODEL=

# --- Working directory the CLI agents operate on ---
# Defaults to the current directory if unset.
AGENT_TARGET_DIR=

# --- Retry loop ---
MAX_TEST_ATTEMPTS=3

# --- Per-CLI permission modes (see README for risk notes) ---
# claude: acceptEdits | auto | bypassPermissions | manual | dontAsk | plan
CLAUDE_PERMISSION_MODE=acceptEdits
# codex sandbox: read-only | workspace-write | danger-full-access
CODEX_SANDBOX_MODE=workspace-write
# opencode: "true" enables --auto (auto-approves permissions, dangerous)
OPENCODE_AUTO_APPROVE=false

# --- Checkpointer ---
CHECKPOINT_DB=.checkpoints/orchestrator.sqlite
